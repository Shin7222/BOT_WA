# ── Identitas Bot ──────────────────────────────────────
BOT_NAME=MyBot
SESSION_NAME=bot-session

# ── Owner & Pairing ────────────────────────────────────
# Format: kode negara + nomor, tanpa + (contoh: 6281234567890)
OWNER_NUMBER=
PAIRING_NUMBER=

# ── Prefix ─────────────────────────────────────────────
# Karakter prefix command, bisa lebih dari satu
PREFIX=!./

# ── Limit System ──────────────────────────────────────
USER_LIMIT=20
PREMIUM_LIMIT=100

# ── Anti-Ban Delay (ms) ────────────────────────────────
SEND_DELAY_MIN=1000
SEND_DELAY_MAX=3000

# ── Cooldown per command (detik) ──────────────────────
COMMAND_COOLDOWN=5

# ── Mode Bot ──────────────────────────────────────────
# public = semua bisa pakai | private = hanya private chat
BOT_MODE=public

# ── Auto Read ─────────────────────────────────────────
# true = centang biru otomatis | false = tidak
AUTO_READ=true

# ── Maintenance Mode ──────────────────────────────────
MAINTENANCE=false

# ── Log Level ─────────────────────────────────────────
LOG_LEVEL=info

# ── Menu Cosmetic ─────────────────────────────────────
MENU_IMAGE_URL=
MENU_LINK_URL=

# ── API Keys (isi yang kamu pakai saja) ───────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=
CLAUDE_API_KEY=
OPENROUTER_API_KEY=
RAPIDAPI_KEY=
WEATHER_API_KEY=